{
  "name": "yuyu-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation for twilighty-abhi/yuyu (product, architecture, APIs, design system, component library, deployment), built with VitePress",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "node scripts/build-tokens.mjs && node scripts/gen-agent-kit.mjs && node scripts/build-search-index.mjs && npm run build:library && vitepress build docs",
    "preview": "vitepress preview docs",
    "start": "vitepress preview docs --port 4173",
    "dev:library": "vite --config library/vite.config.ts",
    "build:library": "vite build --config library/vite.config.ts",
    "typecheck:library": "tsc -p library/tsconfig.json --noEmit",
    "library:sync": "node scripts/sync-library.mjs",
    "predev": "node scripts/gen-agent-kit.mjs && node scripts/build-search-index.mjs && node scripts/ensure-library.mjs",
    "agent-kit": "node scripts/build-tokens.mjs && node scripts/gen-agent-kit.mjs",
    "search-index": "node scripts/build-search-index.mjs",
    "contributors": "node scripts/update-contributors.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "1.49.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.4.1",
    "minisearch": "7.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=18"
  }
}
